# Deliberate production canonical origin, evaluated at build time for BOTH locales.
# Public HTTPS only; no preview/local host, credentials, custom port, path, query or fragment.
# Changing it also requires regenerating both downloadable kits; see the release runbook.
NEXT_PUBLIC_SITE_URL=https://joyccelight-playbook.uxplay.workers.dev
# Free directory pages/downloads are withdrawn. No free checkout is configured.
# Wait for the two real FR/EN Gumroad URLs before adding reviewed redirects.

# Server-side capture tool only. Never prefix this with NEXT_PUBLIC_.
# Use a rotated key in ignored .env.local; never paste it into chat or commit it.
MICROLINK_API_KEY=
